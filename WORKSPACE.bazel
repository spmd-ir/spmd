workspace(name = "spmd")

load("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# ==============================================================================
# SPMD Project Configuration
# ==============================================================================

# Load local Enzyme-JAX repository
load("//externals/enzyme_ad:workspace.bzl", enzyme_ad = "repo")

enzyme_ad()

# Load local Reactant repository
load("//externals/reactant:workspace.bzl", reactant = "repo")

reactant()

# ==============================================================================
# Dependencies from Enzyme-JAX WORKSPACE (required for proper setup)
# ==============================================================================

# Load ML toolchain
load("@enzyme_ad//third_party/ml_toolchain:workspace.bzl", ml_toolchain_workspace = "repo")

ml_toolchain_workspace()

# Load JAX
load("@enzyme_ad//third_party/jax:workspace.bzl", jax_workspace = "repo")

jax_workspace()

# Load XLA
load("@enzyme_ad//third_party/xla:workspace.bzl", xla_workspace = "repo")

xla_workspace()

# XLA workspace setup stages (order matters!)
load("@xla//:workspace4.bzl", "xla_workspace4")

xla_workspace4()

load("@xla//:workspace3.bzl", "xla_workspace3")

xla_workspace3()

# Python initialization (required by XLA)
load("@xla//third_party/py:python_init_rules.bzl", "python_init_rules")

python_init_rules()

load("@xla//third_party/py:python_init_repositories.bzl", "python_init_repositories")

python_init_repositories(
    local_wheel_inclusion_list = [
        "enzyme_ad*",
    ],
    requirements = {
        "3.10": "@enzyme_ad//builddeps:requirements_lock_3_10.txt",
        "3.11": "@enzyme_ad//builddeps:requirements_lock_3_11.txt",
        "3.12": "@enzyme_ad//builddeps:requirements_lock_3_12.txt",
    },
)

load("@xla//third_party/py:python_init_toolchains.bzl", "python_init_toolchains")

python_init_toolchains()

load("@xla//third_party/py:python_init_pip.bzl", "python_init_pip")

python_init_pip()

load("@pypi//:requirements.bzl", "install_deps")

install_deps()

# ==============================================================================
# LLVM Configuration
# ==============================================================================

# Load Enzyme-JAX's LLVM targets or define our own
load("@enzyme_ad//:workspace.bzl", "LLVM_TARGETS")

# Also load flatbuffers (needed by JAX)
load("@jax//third_party/flatbuffers:workspace.bzl", flatbuffers = "repo")

# Load LLVM from XLA
load("@xla//third_party/llvm:workspace.bzl", llvm = "repo")

flatbuffers()

# load externaldeps
load("@jax//third_party/external_deps:workspace.bzl", "external_deps_repository")

external_deps_repository(name = "rocm_external_test_deps")

external_deps_repository(name = "rocm_prebuilt_test_deps")

# Test shard count for JAX
load("@jax//:test_shard_count.bzl", "test_shard_count_repository")

test_shard_count_repository(name = "test_shard_count")

# XLA workspace2
load("@xla//:workspace2.bzl", "xla_workspace2")

xla_workspace2()

# Setup LLVM
llvm("llvm-raw")

load("@llvm-raw//utils/bazel:configure.bzl", "llvm_configure")

# Configure LLVM with targets from Enzyme-JAX
# You can extend this list if you need additional targets
llvm_configure(
    name = "llvm-project",
    targets = LLVM_TARGETS,
)

# ADD THIS — uses //:llvm_openmp_repo.bzl from main project root
load("//:llvm_openmp_repo.bzl", "llvm_openmp_headers")

llvm_openmp_headers(name = "llvm_openmp_headers")

# XLA workspace1
load("@xla//:workspace1.bzl", "xla_workspace1")

xla_workspace1()

# XLA workspace0
load("@xla//:workspace0.bzl", "xla_workspace0")

xla_workspace0()

# ==============================================================================
# JAX Python Wheel Setup
# ==============================================================================

load("@jax//jaxlib:jax_python_wheel.bzl", "jax_python_wheel_repository")

jax_python_wheel_repository(
    name = "jax_wheel",
    version_key = "_version",
    version_source = "@jax//jax:version.py",
)

load(
    "@xla//third_party/py:python_wheel.bzl",
    "nvidia_wheel_versions_repository",
    "python_wheel_version_suffix_repository",
)

nvidia_wheel_versions_repository(
    name = "nvidia_wheel_versions",
    versions_source = "@jax//build:nvidia-requirements.txt",
)

python_wheel_version_suffix_repository(
    name = "jax_wheel_version_suffix",
)

# ==============================================================================
# CUDA Configuration (for GPU support)
# ==============================================================================

load(
    "@xla//third_party/gpus/cuda/hermetic:cuda_json_init_repository.bzl",
    "cuda_json_init_repository",
)

cuda_json_init_repository()

load(
    "@cuda_redist_json//:distributions.bzl",
    "CUDA_REDISTRIBUTIONS",
    "CUDNN_REDISTRIBUTIONS",
)
load(
    "@xla//third_party/gpus/cuda/hermetic:cuda_redist_init_repositories.bzl",
    "cuda_redist_init_repositories",
    "cudnn_redist_init_repository",
)

cuda_redist_init_repositories(
    cuda_redistributions = CUDA_REDISTRIBUTIONS,
)

cudnn_redist_init_repository(
    cudnn_redistributions = CUDNN_REDISTRIBUTIONS,
)

load(
    "@xla//third_party/gpus/cuda/hermetic:cuda_configure.bzl",
    "cuda_configure",
)

cuda_configure(name = "local_config_cuda")

# ==============================================================================
# NCCL Configuration (for multi-GPU support)
# ==============================================================================

load(
    "@xla//third_party/nccl/hermetic:nccl_redist_init_repository.bzl",
    "nccl_redist_init_repository",
)

nccl_redist_init_repository()

load(
    "@xla//third_party/nccl/hermetic:nccl_configure.bzl",
    "nccl_configure",
)

nccl_configure(name = "local_config_nccl")

# ==============================================================================
# Enzyme Configuration
# ==============================================================================

load("@enzyme_ad//third_party/enzyme:workspace.bzl", enzyme_workspace = "repo")

enzyme_workspace()

# ==============================================================================
# CUDA Tile Configuration
# ==============================================================================

load("@enzyme_ad//third_party/cuda_tile:workspace.bzl", cuda_tile_workspace = "repo")

cuda_tile_workspace(repo_name = "@enzyme_ad")

# ==============================================================================
# Development Tools (Optional - for compile_commands.json generation)
# ==============================================================================

# Hedron compile commands (for IDE integration like clangd)
load("@enzyme_ad//third_party/hedron_compile_commands:workspace.bzl", hedron_compile_commands_workspace = "repo")

hedron_compile_commands_workspace()

load("@hedron_compile_commands//:workspace_setup.bzl", "hedron_compile_commands_setup")
load("@hedron_compile_commands//:workspace_setup_transitive.bzl", "hedron_compile_commands_setup_transitive")
load("@hedron_compile_commands//:workspace_setup_transitive_transitive.bzl", "hedron_compile_commands_setup_transitive_transitive")
load("@hedron_compile_commands//:workspace_setup_transitive_transitive_transitive.bzl", "hedron_compile_commands_setup_transitive_transitive_transitive")

hedron_compile_commands_setup()

hedron_compile_commands_setup_transitive()

hedron_compile_commands_setup_transitive_transitive()

hedron_compile_commands_setup_transitive_transitive_transitive()

# ==============================================================================
# Notes:
# - This setup reuses Enzyme-JAX's LLVM_TARGETS from workspace.bzl
# - All dependencies are loaded in the correct order as per Enzyme-JAX's WORKSPACE
# - CUDA and NCCL are configured for GPU/multi-GPU support
# - Python dependencies are set up for JAX integration
# - Hedron compile commands is included for better IDE support
#
# To customize LLVM targets, modify LLVM_TARGETS in @enzyme_ad//:workspace.bzl
# or override the llvm_configure() call above with your own target list.
# ==============================================================================

# ==============================================================================
# Additional Dependencies Required by NEW COMPONENT REACTANT
# ==============================================================================

