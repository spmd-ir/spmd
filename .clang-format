# Plain upstream LLVM style, deliberately without local tweaks: this project is
# an MLIR dialect, so code moved in from or aligned with llvm-project/mlir
# should not churn on arrival. Enzyme-JAX uses the same single-line config.
BasedOnStyle: LLVM
