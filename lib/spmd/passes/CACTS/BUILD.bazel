# SPMD CACTS (Collective API Call Transformation System) Library

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "utils",
    srcs = ["utils.cpp"],
    hdrs = ["utils.h"],
    includes = ["."],
    deps = [
        "//include/spmd:SPMDOps",
        "//include/spmd:SPMDTraits",
        "@enzyme_ad//src/enzyme_ad/jax:EnzymeXLADialect",
        "@llvm-project//mlir:IR",
    ],
)

# The CACTS map's own vocabulary -- the entry, operand and result structs, the
# injected-value helpers and the USIS reader -- without any one model's map.
# The lowerings read it to invert the map they are the other direction of.
cc_library(
    name = "Common",
    hdrs = ["common.h"],
    includes = ["."],
    deps = [
        ":utils",
        "//include/spmd:SPMDOps",
        "//include/spmd:SPMDTraits",
        "//include/spmd/TargetABI:MPICH",
        "@llvm-project//mlir:IR",
    ],
)

