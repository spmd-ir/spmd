# Lowerings of the SPMD dialect to a programming model's runtime calls.

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "LowerSPMDCommon",
    srcs = ["LowerSPMDCommon.cpp"],
    hdrs = ["LowerSPMDCommon.h"],
    includes = ["."],
    deps = [
        "//include/spmd:SPMDDialect",
        "//include/spmd:SPMDOps",
        "//include/spmd/Utils:PassUtilsHeader",
        "@enzyme_ad//src/enzyme_ad/jax:EnzymeXLADialect",
        "@llvm-project//mlir:GPUDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:TransformUtils",
        # Not used here, but SPMDOps.h includes their generated headers and
        # //include/spmd:SPMDOps does not export them, so Bazel's inclusion
        # check needs them listed.
        "@llvm-project//mlir:AffineDialect",
        "@llvm-project//mlir:ParallelCombiningOpInterface",
        "@llvm-project//mlir:SCFDialect",
    ],
)

# The inversion every lowering shares: one slot per C argument, derived from
# the CACTS map the raiser reads and the USIS API description rather than
# written out again, and the rule that picks a call for an operation.
cc_library(
    name = "LoweringTable",
    srcs = ["LoweringTable.cpp"],
    hdrs = ["LoweringTable.h"],
    includes = ["."],
    deps = [
        ":LowerSPMDCommon",
        "//include/spmd:SPMDOps",
        "//include/spmd/Utils:PassUtilsHeader",
        "//lib/spmd/passes/CACTS:Common",
        "@enzyme_ad//src/enzyme_ad/jax:EnzymeXLADialect",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LLVMDialect",
        # Not used here, but SPMDOps.h includes their generated headers and
        # //include/spmd:SPMDOps does not export them, so Bazel's inclusion
        # check needs them listed.
        "@llvm-project//mlir:AffineDialect",
        "@llvm-project//mlir:GPUDialect",
        "@llvm-project//mlir:ParallelCombiningOpInterface",
        "@llvm-project//mlir:SCFDialect",
    ],
)

# What the inversion cannot say about CUDA, which is almost nothing: every
# argument of the two calls the raiser maps is an operand the dialect already
# holds in the C type the prototype wants.
cc_library(
    name = "CUDALoweringTable",
    srcs = ["CUDALoweringTable.cpp"],
    hdrs = ["CUDALoweringTable.h"],
    includes = ["."],
    deps = [
        ":LoweringTable",
        "//lib/spmd/passes/CACTS:CudaTransformer",
        "@llvm-project//mlir:IR",
    ],
)

# What the inversion cannot say about MPI: the MPICH ABI of each argument, and
# which callee to pick when several raise to the same operation.
cc_library(
    name = "MPILoweringTable",
    srcs = ["MPILoweringTable.cpp"],
    hdrs = ["MPILoweringTable.h"],
    includes = ["."],
    deps = [
        ":LoweringTable",
        "//lib/spmd/passes/CACTS:MpiTransformer",
        "@llvm-project//mlir:IR",
    ],
)

# What the inversion cannot say about NCCL: the ABI of each argument, and which
# of its two broadcasts to pick.
cc_library(
    name = "NCCLLoweringTable",
    srcs = ["NCCLLoweringTable.cpp"],
    hdrs = ["NCCLLoweringTable.h"],
    includes = ["."],
    deps = [
        ":LoweringTable",
        "//lib/spmd/passes/CACTS:NcclTransformer",
        "@llvm-project//mlir:IR",
    ],
)

# What the inversion cannot say about the OpenSHMEM family -- OpenSHMEM and
# NVSHMEM: the ABI of each argument, and which of the many spellings of one call
# to pick.
cc_library(
    name = "SHMEMLoweringTable",
    srcs = ["SHMEMLoweringTable.cpp"],
    hdrs = ["SHMEMLoweringTable.h"],
    includes = ["."],
    deps = [
        ":LoweringTable",
        "//lib/spmd/passes/CACTS:NvshmemTransformer",
        "//lib/spmd/passes/CACTS:ShmemTransformer",
        "@llvm-project//mlir:IR",
    ],
)

# What the inversion cannot say about OpenMP's runtime queries, which is
